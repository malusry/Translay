{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translay Mac Preview",
  "version": "0.1.0",
  "identifier": "com.malusry.translay.macos-spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Translay Mac Preview",
        "width": 680,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": ["spike-settings"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "icon": [
      "../../../src-tauri/icons/128x128.png",
      "../../../src-tauri/icons/128x128@2x.png",
      "../../../src-tauri/icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
