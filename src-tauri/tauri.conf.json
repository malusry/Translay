{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translay",
  "version": "0.5.0",
  "identifier": "com.malusry.translay",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": [
        "overlay-capability",
        "settings-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Translay contributors",
    "homepage": "https://github.com/malusry/Translay",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Translay contributors",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Windows 全局划词翻译工具",
    "longDescription": "使用本地或 OpenAI-compatible 模型，在 Windows 中通过全局快捷键翻译选中文字。",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    }
  }
}
