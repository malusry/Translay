{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translay",
  "version": "0.3.0",
  "identifier": "com.translay.techspike",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": [
        "overlay-capability",
        "settings-capability"
      ]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
